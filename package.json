{
  "name": "gcse-spec-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node scripts/sync-content.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-content.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p sw",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "content:extract": "node scripts/extract-legacy.ts",
    "content:check": "node scripts/extract-legacy.ts --check",
    "content:sync": "node scripts/sync-content.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:drift": "prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma/schema.prisma --exit-code",
    "vercel-build": "prisma migrate deploy && next build --webpack"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.0",
    "@serwist/next": "^9.5.0",
    "idb": "^8.0.0",
    "motion": "^12.23.0",
    "next": "^16.0.0",
    "nodemailer": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.18.0",
    "@types/nodemailer": ">=6.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^27.0.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
