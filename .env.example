# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tracker?schema=app
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tracker?schema=app
APP_URL=http://localhost:3000

# Long random strings (see README). Different in every environment.
OTP_PEPPER=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string

# Email: "file" writes codes to .mail/ (local and tests); "gmail" sends real email.
MAIL_TRANSPORT=file
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# AI marking. AI_MOCK=1 uses a predictable stand-in (local and tests only; refused on Vercel).
# GEMINI_API_KEY=
AI_MOCK=1
# AI_ALLOWED_EMAILS=
AI_DAILY_CAP=150
GEMINI_MODEL=gemini-flash-latest
